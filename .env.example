# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"

TMDB_API_KEY=""
TMDB_LIST_CACHE_TTL_SECONDS=1800
# TMDB_FETCH_TIMEOUT_MS=9000
# TMDB_FETCH_RETRIES=2
# TMDB_FETCH_RETRY_BASE_MS=300
# TMDB_CACHE_MAX_MB=768
# TMDB_CACHE_MAX_AGE_DAYS=30
VHS_RENDERER="sharp"
VHS_SHARP_RENDER_SIZE=1800
# VHS_RENDER_CACHE_MAX_MB=2048
# VHS_RENDER_CACHE_MAX_AGE_DAYS=45
NEXT_PUBLIC_VHS_OPEN_EFFECT="false"
# Optional: override local SQLite path for club board state
# CLUB_DB_PATH="data/club/filmklubb.sqlite"
# Optional: override the generated server-only voter identity secret file
# FILM_VOTE_SECRET_PATH="data/club/.film-vote-secret"

# Club administration: enable ONLY for first-time local setup with pnpm dev.
# FILMKLUBB_LOCAL_ADMIN=1
# Durable password hash/session signing file (never commit this file).
# FILMKLUBB_ADMIN_AUTH_PATH="data/club/admin-auth.json"
# Public HTTPS origin, without a path; required for remote admin writes.
# FILMKLUBB_ADMIN_ORIGIN="https://filmklubb.example.org"
# Optional subdirectory: set before pnpm build, leave unset for root hosting.
# NEXT_PUBLIC_BASE_PATH="/filmklubb"
